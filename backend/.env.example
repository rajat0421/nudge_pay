# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (Supabase PostgreSQL) ---------------------------------------
# NudgePay has no local database — Supabase is the only Postgres it talks to,
# in every environment. Get both connection strings from your Supabase
# project: Project Settings -> Database -> Connection string.
#
# DATABASE_URL: the pooled "Transaction" connection (port 6543, pgbouncer).
# The running app uses this one — Fastify + the reminder worker open many
# short-lived connections, which is exactly what the pooler is for.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL: the direct connection (port 5432, no pgbouncer). Only
# `prisma migrate` / `prisma db seed` use this — pgbouncer's transaction
# pooling mode can't run schema migrations.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth ------------------------------------------------------------------
# Generate strong random values, e.g. `openssl rand -hex 32`. Never reuse
# these two secrets for both token types, and never commit real values.
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Email -------------------------------------------------------------
# Shared HTTP email service — not Resend, not SMTP. Leave
# EMAIL_SERVICE_API_KEY unset in development to use the console email
# provider instead, which logs rendered emails rather than sending them.
EMAIL_SERVICE_URL=https://college-management-zfbc.vercel.app/api/send
EMAIL_SERVICE_API_KEY=

# --- App -----------------------------------------------------------------
# APP_URL is the *backend's own* base URL (used as the OpenAPI/Swagger
# "server" field at /docs) — not the frontend's. CORS_ORIGIN is where the
# frontend runs, so the API accepts requests from it.
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# --- Reminder engine -------------------------------------------------------
CRON_INTERVAL_MINUTES=15
MAX_EMAIL_RETRIES=4
# Set to "false" if you run `npm run worker:start` as a separate process/service.
RUN_JOBS_IN_API_PROCESS=true
